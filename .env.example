# Copy to .env for local development. Never commit real credentials.
SMART_DAILY_DATABASE_PATH=data/daily_reports.sqlite3
SMART_DAILY_TIMEZONE=Asia/Shanghai
SMART_DAILY_RECIPIENTS=
SMART_DAILY_MOCK_ACTORS=alice,bob,carol

# GitHub. GITHUB_TOKEN is optional for public repositories.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_ACTOR_MAP=github_login_alice=alice,github_login_bob=bob

# Feishu. Actor maps use open_id=canonical_id.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_ACTOR_MAP=ou_alice=alice,ou_bob=bob

# SMTP. Keep all real values in the local .env file only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
